# keel-master as a systemd service. Copy to /etc/systemd/system/, adjust
# ExecStart, then: systemctl daemon-reload && systemctl enable --now keel-master
#
# Restart=always matters: the release build aborts on any panic, so without a
# supervisor one bug would keep the panel, subscriptions and the node channel
# down until someone noticed.
[Unit]
Description=keel-master
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/local/bin/keel-master -data /var/lib/keel-master -listen 0.0.0.0:8443
Restart=always
RestartSec=3
LimitNOFILE=65536
MemoryMax=512M
DynamicUser=yes
StateDirectory=keel-master
StateDirectoryMode=0700
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
